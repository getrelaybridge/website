---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const topics = [
  ['01', 'Getting started', 'Install, configure, and verify a RelayBridge instance.', 'In preparation'],
  ['02', 'Microsoft 365 setup', 'Create and scope the Microsoft identity used for SMTP submission.', 'In preparation'],
  ['03', 'Adding a device', 'Authorize a printer, scanner, appliance, or legacy application.', 'In preparation'],
  ['04', 'Printer SMTP settings', 'Map common device fields to the local RelayBridge listener.', 'In preparation'],
  ['05', 'Security', 'Understand the data path, identity, authorization, and current limitations.', 'Available', '/security/'],
  ['06', 'Troubleshooting', 'Diagnose local submission, queue, OAuth, and Microsoft SMTP issues.', 'In preparation'],
  ['07', 'Upgrading', 'Move between RelayBridge versions while preserving safe local state.', 'In preparation'],
];
---

<BaseLayout title="RelayBridge documentation" description="RelayBridge documentation for Microsoft 365 setup, legacy SMTP devices, security, troubleshooting, and upgrades.">
  <PageHero eyebrow="Documentation" title="Clear guidance for" accent="a careful deployment." description="Operational documentation is being prepared alongside the public v1.0.0-rc.1 evaluation release so that instructions match the final setup flow and security boundaries." />

  <section class="docs-status">
    <div class="container docs-status-inner"><span></span><p><strong>Documentation status</strong> Problem-solving guides and the public security architecture are available now. Full product setup documentation is still being prepared beyond the v1.0.0-rc.1 evaluation release.</p></div>
  </section>

  <section class="section section-white">
    <div class="container">
      <a class="docs-guides-promo" href="/guides/">
        <span>GUIDES · AVAILABLE NOW</span>
        <div><h2>Microsoft 365 SMTP problem-solving guides</h2><p>Read practical explanations for legacy printers, scan-to-email workflows, and applications that cannot use modern authentication directly.</p></div>
        <b aria-hidden="true">→</b>
      </a>
      <div class="section-intro section-intro-row docs-intro">
        <div><p class="eyebrow"><span></span> Product documentation</p><h2>Installation guidance<br /><em>is still in preparation.</em></h2></div>
        <p class="section-lede">Unlike the explanatory guides above, these topics will describe RelayBridge installation and configuration. The public RC is available, but detailed steps will remain in preparation until packaging and native Microsoft setup are frozen.</p>
      </div>
      <div class="docs-grid">
        {topics.map(([number, title, description, status, href]) => (
          <article>
            <div><span class="topic-number">{number}</span><span class:list={['topic-status', status === 'Available' && 'is-available']}>{status}</span></div>
            <h3>{title}</h3>
            <p>{description}</p>
            {href ? <a class="text-link" href={href}>Read now <span aria-hidden="true">→</span></a> : <span class="topic-pending">In preparation</span>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section docs-bottom">
    <div class="container two-column-copy">
      <div><p class="eyebrow"><span></span> Follow development</p><h2>Need the latest<br /><em>project status?</em></h2></div>
      <div><p class="section-lede">RelayBridge source is public on GitHub under MPL-2.0. An unsigned Windows x64 release candidate is available for evaluation and community testing; full deployment guidance and a signed stable release are not yet available.</p><div class="button-row"><a class="button button-ink" href="/download/">Review release status <span aria-hidden="true">→</span></a><a class="text-link" href="https://github.com/getrelaybridge/relaybridge">View source</a></div></div>
    </div>
  </section>
</BaseLayout>
