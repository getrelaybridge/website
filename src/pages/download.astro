---
import BaseLayout from '../layouts/BaseLayout.astro';
import downloadArtwork from '../assets/page-art/download-status.webp';
---

<BaseLayout title="RelayBridge downloads — Windows release in preparation" description="RelayBridge source is public under MPL-2.0. Official signed Windows binaries are not yet publicly released." image={downloadArtwork.src} imageAlt="RelayBridge release-status illustration showing a Windows service, local daemon, certificate keystore, and GitHub repository around an active-development package.">
  <section class="download-page section-dark">
    <div class="container download-grid">
      <div>
        <p class="eyebrow eyebrow-light"><span></span> Downloads</p>
        <h1>RelayBridge<br /><em>downloads.</em></h1>
        <p class="download-lede">Official Windows binaries are not publicly released yet.</p>
        <p>RelayBridge source is public under MPL-2.0. The official signed MSI and bootstrapper remain in release preparation and are not available as production downloads.</p>
        <div class="button-row"><a class="button button-accent" href="https://github.com/getrelaybridge/relaybridge">View source on GitHub <span aria-hidden="true">→</span></a><a class="button button-ghost" href="/docs/">Read the docs status</a></div>
      </div>
      <div class="release-card">
        <div class="release-card-head"><span>RELEASE CHANNEL</span><b>WINDOWS</b></div>
        <div class="release-status-icon" aria-hidden="true"><i></i></div>
        <h2>Release preparation</h2>
        <p>No official Windows installer is publicly available.</p>
        <dl><div><dt>Version</dt><dd>Not published</dd></div><div><dt>Platform</dt><dd>Primarily Windows</dd></div><div><dt>Status</dt><dd><span></span> Active development</dd></div></dl>
      </div>
    </div>
  </section>
  <section class="section section-white">
    <div class="container narrow-copy">
      <p class="eyebrow"><span></span> Before the first release</p>
      <h2>Accurate instructions come before a download button.</h2>
      <p class="section-lede">The release page will point to official GitHub Releases when public builds exist. Until then, we will not publish placeholder binaries, invented versions, or incomplete setup instructions.</p>
    </div>
  </section>
</BaseLayout>
