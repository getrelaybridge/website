---
import BaseLayout from '../layouts/BaseLayout.astro';
import downloadArtwork from '../assets/page-art/download-status.webp';
---

<BaseLayout title="RelayBridge downloads — v1.0 in preparation" description="Public RelayBridge v1.0 builds are not available yet. Follow development and releases on GitHub." image={downloadArtwork.src} imageAlt="RelayBridge release-status illustration showing a Windows service, local daemon, certificate keystore, and GitHub repository around an active-development package.">
  <section class="download-page section-dark">
    <div class="container download-grid">
      <div>
        <p class="eyebrow eyebrow-light"><span></span> Downloads</p>
        <h1>RelayBridge<br /><em>downloads.</em></h1>
        <p class="download-lede">Public v1.0 builds are not available yet.</p>
        <p>RelayBridge is under active development. We will link to official public releases only after the installer, setup flow, and security validation are ready.</p>
        <div class="button-row"><a class="button button-accent" href="https://github.com/getrelaybridge">Follow releases on GitHub <span aria-hidden="true">→</span></a><a class="button button-ghost" href="/docs/">Read the docs status</a></div>
      </div>
      <div class="release-card">
        <div class="release-card-head"><span>RELEASE CHANNEL</span><b>PUBLIC</b></div>
        <div class="release-status-icon" aria-hidden="true"><i></i></div>
        <h2>Preparing v1.0</h2>
        <p>No public build is available to download.</p>
        <dl><div><dt>Version</dt><dd>Not published</dd></div><div><dt>Platform</dt><dd>Primarily Windows</dd></div><div><dt>Status</dt><dd><span></span> Active development</dd></div></dl>
      </div>
    </div>
  </section>
  <section class="section section-white">
    <div class="container narrow-copy">
      <p class="eyebrow"><span></span> Before the first release</p>
      <h2>Accurate instructions come before a download button.</h2>
      <p class="section-lede">The release page will point to official GitHub Releases when public builds exist. Until then, we will not publish placeholder binaries, invented versions, or incomplete setup instructions.</p>
    </div>
  </section>
</BaseLayout>
