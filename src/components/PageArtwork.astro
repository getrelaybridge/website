---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  ariaLabel?: string;
}

const {
  image,
  alt,
  caption,
  ariaLabel = 'Page illustration',
} = Astro.props;
---

<section class="guide-visual-band" aria-label={ariaLabel}>
  <figure class="container guide-visual">
    <a class="guide-visual-image-link" href={image.src} target="_blank" rel="noopener" aria-label="Open the full-size illustration">
      <Image
        src={image}
        alt={alt}
        widths={[480, 720, 960, 1200, 1376]}
        sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1200px) calc(100vw - 80px), 1120px"
        format="webp"
        quality={88}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </a>
    {caption && <figcaption><span>{caption}</span><a href={image.src} target="_blank" rel="noopener">View full-size illustration</a></figcaption>}
  </figure>
</section>
