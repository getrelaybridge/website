---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import CallToAction from './CallToAction.astro';
import PageArtwork from './PageArtwork.astro';
import type { ImageMetadata } from 'astro';

interface TocItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  summary: string;
  toc: TocItem[];
  image?: ImageMetadata;
  imageAlt?: string;
  imageCaption?: string;
  verified?: string;
  verifiedISO?: string;
}

const { title, description, eyebrow, heading, summary, toc, image, imageAlt, imageCaption, verified, verifiedISO } = Astro.props;
---

<BaseLayout title={title} description={description} image={image?.src} imageAlt={imageAlt}>
  <PageHero eyebrow={eyebrow} title={heading} description={summary} />

  {image && imageAlt && (
    <PageArtwork image={image} alt={imageAlt} caption={imageCaption} ariaLabel="Guide architecture overview" />
  )}

  <section class="guide-status" aria-label="Release status">
    <div class="container guide-status-inner">
      <span aria-hidden="true"></span>
      <p><strong>Public RC note</strong> RelayBridge v1.0.0-rc.1 is available as an unsigned pre-release for evaluation and community testing. It is not the signed stable release. <a href="/download/">Check release status</a>.</p>
    </div>
  </section>

  {verified && (
    <section class="guide-trust" aria-label="Guide technical verification">
      <div class="container guide-trust-inner">
        <p><span>Last technically verified</span><time datetime={verifiedISO}>{verified}</time></p>
      </div>
    </section>
  )}

  <section class="section section-white">
    <div class="container guide-layout">
      <aside class="guide-toc section-aside">
        <p class="eyebrow"><span></span> On this page</p>
        <nav aria-label="Guide sections">
          {toc.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="guide-back-link" href="/guides/">← All guides</a>
      </aside>
      <article class="guide-prose">
        <slot />
      </article>
    </div>
  </section>

  <CallToAction eyebrow="Understand the boundary" title="Review the architecture before evaluation." description="See how RelayBridge separates local SMTP intake from modern Microsoft 365 delivery, and review the current security model and limitations." primaryHref="/how-it-works/" primaryLabel="How it works" secondaryHref="/security/" secondaryLabel="Security" />
</BaseLayout>
