---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import CallToAction from './CallToAction.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface TocItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  summary: string;
  toc: TocItem[];
  image?: ImageMetadata;
  imageAlt?: string;
  imageCaption?: string;
}

const { title, description, eyebrow, heading, summary, toc, image, imageAlt, imageCaption } = Astro.props;
---

<BaseLayout title={title} description={description} image={image?.src} imageAlt={imageAlt}>
  <PageHero eyebrow={eyebrow} title={heading} description={summary} />

  {image && imageAlt && (
    <section class="guide-visual-band" aria-label="Guide architecture overview">
      <figure class="container guide-visual">
        <a class="guide-visual-image-link" href={image.src} target="_blank" rel="noopener" aria-label="Open the full-size guide diagram">
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 720, 960, 1200, 1376]}
            sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1200px) calc(100vw - 80px), 1120px"
            format="webp"
            quality={88}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </a>
        {imageCaption && <figcaption><span>{imageCaption}</span><a href={image.src} target="_blank" rel="noopener">View full-size diagram</a></figcaption>}
      </figure>
    </section>
  )}

  <section class="guide-status" aria-label="Release status">
    <div class="container guide-status-inner">
      <span aria-hidden="true"></span>
      <p><strong>Pre-release note</strong> RelayBridge is under active development. No public v1.0 build or finalized setup guide is available yet. <a href="/download/">Check release status</a>.</p>
    </div>
  </section>

  <section class="section section-white">
    <div class="container guide-layout">
      <aside class="guide-toc section-aside">
        <p class="eyebrow"><span></span> On this page</p>
        <nav aria-label="Guide sections">
          {toc.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="guide-back-link" href="/guides/">← All guides</a>
      </aside>
      <article class="guide-prose">
        <slot />
      </article>
    </div>
  </section>

  <CallToAction eyebrow="Understand the boundary" title="Review the architecture before release." description="See how RelayBridge separates local SMTP intake from modern Microsoft 365 delivery, and review the current security model and limitations." primaryHref="/how-it-works/" primaryLabel="How it works" secondaryHref="/security/" secondaryLabel="Security" />
</BaseLayout>
